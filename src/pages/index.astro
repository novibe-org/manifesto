---
import Layout from "../layouts/Layout.astro";

const slogans = [
  ["Intent", "Output", "bg-yellow"],
  ["Spec", "Prompt", "bg-pink"],
  ["Small slices", "Big prompts", "bg-mint"],
  ["Guard rails", "Guidance", "bg-orange"],
  ["Contract", "Briefing", "bg-white"],
  ["Standards", "Invention", "bg-yellow"],
  ["Decide", "Type", "bg-pink"],
  ["Driver", "Passenger", "bg-mint"],
];

const skipped = [
  "acceptance criteria in Gherkin",
  "the test before the code",
  "an architecture designed, documented, and easy to find",
];

const lessons = [
  {
    s: "Intent > Diff",
    h: "Review the intent, not the diff.",
    p: "Reading a thousand generated lines is review hell. Review the scenario and the design before a line exists; the tests prove the rest.",
    bg: "bg-blue",
    tilt: "tilt-l",
    sticker: "bg-yellow",
  },
  {
    s: "Small slices > Big prompts",
    h: "Small slices beat big prompts.",
    p: "The bigger the ask, the more the machine fills with its own defaults. One rule, a few scenarios, one session — and you stay the author.",
    bg: "bg-orange",
    tilt: "tilt-r",
    sticker: "bg-white",
  },
  {
    s: "Guard rails > Guidance",
    h: "Guidance isn't enforcement.",
    p: "An agent follows its instructions most of the time. What has to hold every time is a git hook, a test, a linter — deterministic, whatever the agent made of its prompt.",
    bg: "bg-violet",
    tilt: "tilt-l",
    sticker: "bg-mint",
  },
];
---

<Layout page="manifesto">
  <main class="canvas">
    <header class="card hero bg-yellow span-8">
      <span class="sticker bg-white">The NoVibe Manifesto</span>
      <h1>Intent is the work, not&nbsp;output.</h1>
      <p class="deck">
        A few words of hope become a mountain of code that cannot be what you meant — because you
        never said what you meant. The gaps you leave are filled by the machine's defaults, not your
        intent.
      </p>
      <p class="claim">You manage the intent. The machine writes the code.</p>
      <div class="ctas">
        <a class="btn" href="/practice">How we work →</a>
        <a class="btn alt" href="/tools">What we built →</a>
      </div>
    </header>

    <aside class="card span-4 bg-ink tilt-r danger">
      <span class="sticker bg-orange">⚠ Danger</span>
      <p>
        Skip that work and you don't get magic — you get danger. Insecure code ships easily now,
        because the risk lived in the requirements you never set.
      </p>
    </aside>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {
          [...slogans, ...slogans].map(([a, b, bg]) => (
            <span class:list={["sticker", bg]}>
              {a} &gt; {b}
            </span>
          ))
        }
      </div>
    </div>

    <section class="card span-8 bg-mint knew">
      <span class="sticker bg-white">Knew it &gt; Did it</span>
      <h2>What everyone knew, and almost no one did.</h2>
      <ul class="skipped">
        {
          skipped.map((s) => (
            <li>
              <span class="should">Everyone should have written {s}.</span>
              <span class="verdict">
                <s>effort</s> <span class="sticker bg-yellow">now the cheap part</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p>
        Not because they were wrong — because they took effort, and effort was the first thing cut
        when time ran short. That has inverted. An agent asks the questions until the scenarios hold,
        writes the tests before the code, and keeps the model and the decisions next to it.
      </p>
      <p class="claim small">A high-quality codebase is a default you choose — not a budget you fight for.</p>
    </section>

    <section class="card span-4 tilt-l">
      <span class="sticker bg-blue">Standards &gt; Invention</span>
      <h2>Standards, not invention.</h2>
      <p>Gherkin, C4, arc42, ADRs: what is known to work, in words every engineer already knows.</p>
      <div class="chips">
        <span>Gherkin</span><span>BDD</span><span>TDD</span><span>C4</span><span>arc42</span><span>ADR</span>
      </div>
    </section>

    {
      lessons.map((l) => (
        <section class:list={["card", "span-4", l.bg, l.tilt]}>
          <span class:list={["sticker", l.sticker]}>{l.s}</span>
          <h2>{l.h}</h2>
          <p>{l.p}</p>
        </section>
      ))
    }

    <section class="card span-5 tilt-r">
      <span class="sticker bg-pink">Contract &gt; Briefing</span>
      <h2>A contract, not a briefing.</h2>
      <p>
        Agents briefing agents pass on misinformation — read their briefings and you find it. Every
        agent reads the spec and the model first-hand.
      </p>
      <div class="relay" aria-hidden="true">
        <span class="hop">spec</span><span class="arrow">→</span><span class="hop bad">brief</span><span class="arrow">→</span><span class="hop bad">brief of brief</span><span class="arrow">→</span><span class="hop bad">??</span>
      </div>
    </section>

    <section class="card span-7 bg-ink ide">
      <span class="sticker bg-yellow">Decide &gt; Type</span>
      <h2>You don't need an IDE.</h2>
      <p class="ide-strike" aria-hidden="true"><s>IDE</s></p>
      <p>
        An IDE is a tool for editing text, and you no longer edit text: you decide, you read, you
        review. What you need is a sandbox for the agent, viewers for the spec and the design, fast
        tools for skipping through code and changes — and guard rails.
      </p>
      <a class="btn alt" href="/tools">The NoVibe stack →</a>
    </section>

    <section class="card span-5 bg-yellow tilt-l">
      <span class="sticker bg-white">Heavy &gt; Light</span>
      <h2>The heavy tools get light.</h2>
      <p>
        Ticket trackers were built for writing long tickets; with the intent in the spec, they keep
        the epics and the priorities, nothing more. Wiki pages give way to a knowledge graph of the
        domain — coming to NoVibe.
      </p>
    </section>

    <section class="card span-7 roles">
      <span class="sticker bg-mint">Driver &gt; Passenger</span>
      <h2>The machine writes the code now. That leaves two ways to work.</h2>
      <div class="dichotomy">
        <div class="col passenger">
          <p class="role">Passenger <span>the translator</span></p>
          <ul>
            <li>prompts, and hopes</li>
            <li>reviews what the machine made</li>
            <li>trapped in review hell</li>
          </ul>
        </div>
        <div class="col driver">
          <p class="role">Driver <span>the author</span></p>
          <ul>
            <li>decides the intent</li>
            <li>reviews the spec and the design</li>
            <li>owns it, from intent to ship</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="card span-12 bg-violet punch">
      <h2>Be the driver, never the passenger.</h2>
      <div class="ctas">
        <a class="btn alt" href="/practice">How we work →</a>
        <a class="btn alt" href="/tools">What we built →</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero h1 {
    font-size: clamp(3rem, 6.5vw, 6.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .deck {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    max-width: 40rem;
  }

  .claim {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    line-height: 1.05;
    background: var(--ink);
    color: var(--yellow);
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 12px;
    transform: rotate(-1deg);
  }

  .claim.small {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--mint);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding-top: 0.6rem;
  }










  .danger p {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .skipped {
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }

  .skipped li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    background: var(--white);
    border: var(--border);
    border-radius: 14px;
    padding: 0.7rem 1rem;
  }

  .should {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
  }

  .verdict {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
  }

  .verdict s {
    color: #c92a2a;
    text-decoration-thickness: 3px;
  }

  .verdict .sticker {
    font-size: 0.9rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chips span {
    font-weight: 800;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    background: var(--paper);
  }

  .relay {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-weight: 800;
  }

  .hop {
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 0.2rem 0.6rem;
    background: var(--mint);
  }

  .hop.bad {
    background: var(--paper);
    color: #c92a2a;
  }

  .hop.bad:nth-of-type(2) { transform: rotate(-2deg); }
  .hop.bad:nth-of-type(3) { transform: rotate(3deg); }
  .hop.bad:nth-of-type(4) { transform: rotate(-6deg); }

  .ide-strike {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 1;
    color: var(--paper);
  }

  .ide-strike s {
    text-decoration-color: var(--pink);
    text-decoration-thickness: 0.12em;
  }

  .dichotomy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .col {
    border: var(--border);
    border-radius: 16px;
    padding: 1rem 1.2rem;
  }

  .passenger {
    background: #eeeeee;
    color: var(--faint);
    border-style: dashed;
  }

  .driver {
    background: var(--mint);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .role {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.6rem;
    margin-bottom: 0.4rem;
  }

  .role span {
    display: block;
    font-family: "Inter Variable", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .col ul {
    list-style: none;
    display: grid;
    gap: 0.3rem;
    font-weight: 600;
  }

  .punch {
    text-align: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .punch h2 {
    font-size: clamp(2.6rem, 7vw, 6rem);
    letter-spacing: -0.04em;
  }

  .punch .ctas {
    justify-content: center;
  }

  @media (max-width: 560px) {
    .dichotomy {
      grid-template-columns: 1fr;
    }
  }
</style>
